<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="270dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel"
    android:elevation="8dp"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/panelHandle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/panel_title"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/panelClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_button_secondary"
            android:contentDescription="@string/panel_close"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/text"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/panelStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/panel_waiting"
        android:textColor="@color/text"
        android:textSize="13sp" />

    <Button
        android:id="@+id/panelScan"
        style="@style/Button.Primary"
        android:layout_height="46dp"
        android:text="@string/panel_scan" />

    <Button
        android:id="@+id/panelLive"
        style="@style/Button.Secondary"
        android:layout_height="42dp"
        android:layout_marginTop="8dp"
        android:text="@string/panel_live_on" />

    <Button
        android:id="@+id/panelAim"
        style="@style/Button.Secondary"
        android:layout_height="42dp"
        android:layout_marginTop="8dp"
        android:text="@string/panel_aim" />

    <Button
        android:id="@+id/panelPlay"
        style="@style/Button.Secondary"
        android:layout_height="42dp"
        android:layout_marginTop="8dp"
        android:text="@string/panel_play" />

    <Button
        android:id="@+id/panelSave"
        style="@style/Button.Secondary"
        android:layout_height="42dp"
        android:layout_marginTop="8dp"
        android:text="@string/panel_save"
        android:visibility="gone" />

    <Button
        android:id="@+id/panelOpenApp"
        style="@style/Button.Secondary"
        android:layout_height="42dp"
        android:layout_marginTop="8dp"
        android:text="@string/panel_open_app"
        android:visibility="gone" />
</LinearLayout>
